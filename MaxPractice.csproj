<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net4.8</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>MaxPractice</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Exclude Puck folder from compilation (it contains decompiled reference code) -->
  <ItemGroup>
    <Compile Remove="Puck\**" />
    <EmbeddedResource Remove="Puck\**" />
    <None Remove="Puck\**" />
  </ItemGroup>

  <!-- Game install paths -->
  <PropertyGroup>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Puck</GameDir>
    <GameManaged>$(GameDir)\Puck_Data\Managed</GameManaged>
    <DeployDir>$(GameDir)\Plugins\MaxPractice</DeployDir>
  </PropertyGroup>

    <!--
      Reference EVERY DLL from the live game's Managed folder so we always
      build against the current build (b897). Local libs/ is kept only for
      a few packages the game doesn't ship (SocketIO, etc).

      Past pitfall: libs/ used to contain stale copies of every game DLL
      from B202, which silently shadowed live references and made the mod
      build against IPuckMod (B202) instead of IPuckPlugin (b323+) — so the
      server's mod loader couldn't find a plugin and the mod never loaded.
    -->
    <ItemGroup>
      <!-- Exclude BCL/system DLLs that conflict with the .NET Framework
           reference assemblies already provided by the SDK (mscorlib,
           netstandard, System.*). The game ships its own copies but using
           them at compile time produces CS0433 duplicate-type errors. -->
      <!-- Puck.dll is pinned to a local snapshot in libs\ (see the explicit
           Puck reference below), so exclude the live copy here to avoid a
           CS0433 duplicate-'Puck' reference. Refresh libs\Puck.dll on each
           game update. -->
      <GameLibs Include="$(GameManaged)\*.dll"
                Exclude="$(GameManaged)\System.dll;$(GameManaged)\System.*.dll;$(GameManaged)\mscorlib.dll;$(GameManaged)\netstandard.dll;$(GameManaged)\Puck.dll" />
      <Reference Include="@(GameLibs)">
        <HintPath>%(GameLibs.FullPath)</HintPath>
        <Private>false</Private>
      </Reference>

      <ExtraLibs Include="libs\*.dll" Exclude="libs\System.*.dll;libs\Puck.dll" />
      <Reference Include="@(ExtraLibs)">
        <HintPath>%(ExtraLibs.FullPath)</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>

  <!-- References to game assemblies -->
  <ItemGroup>
    <!-- Harmony -->
    <Reference Include="0Harmony">
      <HintPath>$(GameManaged)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Main game assembly, pinned to a local snapshot (b1153). Refresh with:
         cp "$(GameManaged)\Puck.dll" libs\Puck.dll -->
    <Reference Include="Puck">
      <HintPath>libs\Puck.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(GameManaged)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity core -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameManaged)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity Netcode -->
    <Reference Include="Unity.Netcode.Runtime">
      <HintPath>$(GameManaged)\Unity.Netcode.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <Reference Include="Unity.Collections">
  <HintPath>$(GameManaged)\Unity.Collections.dll</HintPath>
  <Private>false</Private>
</Reference>

<Reference Include="UnityEngine.JSONSerializeModule">
  <HintPath>$(GameManaged)\UnityEngine.JSONSerializeModule.dll</HintPath>
  <Private>false</Private>
</Reference>

<Reference Include="UnityEngine.UIElementsModule">
        <HintPath>$(GameManaged)\UnityEngine.UIElementsModule.dll</HintPath>
        <Private>false</Private>
      </Reference>
      
      <Reference Include="UnityEngine.UIModule">
        <HintPath>$(GameManaged)\UnityEngine.UIModule.dll</HintPath>
        <Private>false</Private>
      </Reference>

      <Reference Include="UnityEngine.UI">
        <HintPath>$(GameManaged)\UnityEngine.UI.dll</HintPath>
        <Private>false</Private>
      </Reference>

      <Reference Include="UnityEngine.TextCoreFontEngineModule">
        <HintPath>$(GameManaged)\UnityEngine.TextCoreFontEngineModule.dll</HintPath>
        <Private>false</Private>
      </Reference>
            <Reference Include="UnityEngine.TextCoreTextEngineModule">
        <HintPath>$(GameManaged)\UnityEngine.TextCoreTextEngineModule.dll</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- Copy DLL into game plugins after build -->
  <Target Name="CopyToPuckPlugins" AfterTargets="Build">
    <MakeDir Directories="$(DeployDir)" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(DeployDir)" OverwriteReadOnlyFiles="true" />
    <Message Importance="high" Text="Copied $(AssemblyName).dll → $(DeployDir)" />
  </Target>

</Project>
